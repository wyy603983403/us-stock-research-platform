# 研究专用，永远不开启交易
TRADING_ENABLED=false
USR_HTTP_TIMEOUT=30

# 数据存储二选一：
# 1) 默认：CSV 文件放在 USR_DATA_DIR（无额外依赖）
USR_DATA_DIR=data
# 2) Parquet（zstd 压缩，需要 pip install -e '.[storage]'）：设置根目录后自动启用，
#    数据在 <root>/parquet/，数据快照在 <root>/snapshots/。例如放到外置数据卷：
# USR_STORAGE_ROOT=/Volumes/mysql/duckdb-pilot/us-stock-research

# 第二数据源 Stooq（免费，需在浏览器取密钥：https://stooq.com/q/d/?s=spy.us&get_apikey）
# STOOQ_APIKEY=
# 第二数据源 Tiingo（推荐，免费邮箱注册：https://www.tiingo.com）
# TIINGO_TOKEN=
